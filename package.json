{
  "name": "ghc-proxy",
  "type": "module",
  "version": "0.12.3",
  "description": "GitHub Copilot to OpenAI/Anthropic API proxy - Use Copilot with Claude Code, Cursor, and more",
  "author": "wxxb789 <wxxb789@outlook.com>",
  "homepage": "https://github.com/wxxb789/ghc-proxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxxb789/ghc-proxy.git"
  },
  "bugs": "https://github.com/wxxb789/ghc-proxy/issues",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible"
  ],
  "bin": {
    "ghc-proxy": "./dist/main.mjs"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist/**/*.mjs",
    "dist/msc-auth/**"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=26"
  },
  "scripts": {
    "build": "bun run build:ui && tsdown && bun run build:msc-auth",
    "build:msc-auth": "bun scripts/build-msc-auth.mjs",
    "build:ui": "bun scripts/build-ui.ts",
    "dev": "bun run --watch ./src/main.ts start",
    "dev:ui": "vite --config ui/vite.config.ts",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "matrix:live": "bun run scripts/matrix/live-compat-matrix.ts",
    "smoke:cache": "bun run scripts/smoke/cache-control.ts",
    "smoke:packaged": "bun run scripts/smoke/packaged-cli.ts",
    "smoke:translation": "bun run scripts/smoke/translation.ts",
    "serve": "NODE_ENV=production bun run ./src/main.ts start --wait --idle-timeout=255 --upstream-timeout=1800",
    "start": "NODE_ENV=production bun scripts/build-msc-auth.mjs --start",
    "test:ui": "vitest run --root ui",
    "typecheck": "npx tsc --project tsconfig.json && svelte-check --workspace ui --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "elysia": "^1.4.29",
    "fetch-event-stream": "^0.1.6",
    "proxy-from-env": "^2.0.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "^1.4.0",
    "@types/proxy-from-env": "^1.0.4",
    "bumpp": "^11.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "3.23.1",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "30.1.3",
    "knip": "^5.88.1",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.10.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix"
  }
}
