{
  "name": "ghc-proxy",
  "type": "module",
  "version": "0.10.2",
  "description": "GitHub Copilot to OpenAI/Anthropic API proxy - Use Copilot with Claude Code, Cursor, and more",
  "author": "wxxb789 <wxxb789@outlook.com>",
  "homepage": "https://github.com/wxxb789/ghc-proxy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxxb789/ghc-proxy.git"
  },
  "bugs": "https://github.com/wxxb789/ghc-proxy/issues",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible"
  ],
  "bin": {
    "ghc-proxy": "./dist/main.mjs"
  },
  "files": [
    "dist/**/*.mjs"
  ],
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun run --watch ./src/main.ts start",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "bun run build",
    "prepare": "simple-git-hooks",
    "release": "bun run release:patch",
    "release:patch": "bumpp patch --yes --commit --tag",
    "release:minor": "bumpp minor --yes --commit --tag",
    "release:major": "bumpp major --yes --commit --tag",
    "matrix:live": "bun run scripts/matrix/live-compat-matrix.ts",
    "smoke:cache": "bun run scripts/smoke/cache-control.ts",
    "smoke:packaged": "bun run scripts/smoke/packaged-cli.ts",
    "smoke:translation": "bun run scripts/smoke/translation.ts",
    "serve": "NODE_ENV=production bun run ./src/main.ts start --wait --idle-timeout=255 --upstream-timeout=1800",
    "start": "NODE_ENV=production bun run ./src/main.ts start",
    "typecheck": "npx tsc --project tsconfig.json"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "elysia": "^1.4.29",
    "fetch-event-stream": "^0.1.6",
    "gpt-tokenizer": "^3.4.0",
    "proxy-from-env": "^2.0.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/bun": "^1.4.0",
    "@types/proxy-from-env": "^1.0.4",
    "bumpp": "^11.1.0",
    "eslint": "^10.9.1",
    "knip": "^5.88.1",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix"
  }
}
